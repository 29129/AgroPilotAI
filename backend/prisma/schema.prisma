generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PRODUCER
  TECHNICIAN
  ADMIN
}
enum CropStatus {
  ACTIVE
  HARVESTED
  CANCELLED
}
enum DiagnosisStatus {
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}
enum RecommendationCategory {
  CLIMATE
  HEALTH
  IRRIGATION
  NUTRITION
  MARKET
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
enum AnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole        @default(PRODUCER)
  farms        Farm[]
  refreshTokens RefreshToken[]
  conversations Conversation[]
  notifications Notification[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model Farm {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  province    String
  canton      String
  latitude    Float?
  longitude   Float?
  totalAreaHa Float?
  plots       Plot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
}

model Plot {
  id             String   @id @default(uuid()) @db.Uuid
  farmId         String   @db.Uuid
  farm           Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name           String
  areaHa         Float?
  soilType       String?
  irrigationType String?
  crops          Crop[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([farmId])
}

model Crop {
  id                  String      @id @default(uuid()) @db.Uuid
  plotId              String      @db.Uuid
  plot                Plot        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropType            String
  variety             String?
  sowingDate          DateTime?
  expectedHarvestDate DateTime?
  growthStage         String?
  status              CropStatus  @default(ACTIVE)
  diagnoses           Diagnosis[]
  recommendations     Recommendation[]
  weeklyPlans         WeeklyPlan[]
  analyses            Analysis[]
  conversations       Conversation[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  @@index([plotId])
}

model Diagnosis {
  id                 String          @id @default(uuid()) @db.Uuid
  cropId             String          @db.Uuid
  crop               Crop            @relation(fields: [cropId], references: [id], onDelete: Cascade)
  imageUrl            String
  symptoms            String?
  status              DiagnosisStatus @default(COMPLETED)
  finding             String
  confidence          Float
  explanation         String
  requiresTechnicalReview Boolean     @default(false)
  evidence            Json
  createdAt           DateTime        @default(now())
  @@index([cropId])
}

model Analysis {
  id           String         @id @default(uuid()) @db.Uuid
  cropId       String         @db.Uuid
  crop         Crop           @relation(fields: [cropId], references: [id], onDelete: Cascade)
  status       AnalysisStatus @default(COMPLETED)
  analysisType String
  summary      String
  agentResults Json
  generatedAt  DateTime       @default(now())
  @@index([cropId])
}

model Recommendation {
  id               String                 @id @default(uuid()) @db.Uuid
  cropId           String                 @db.Uuid
  crop             Crop                   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  category         RecommendationCategory
  title            String
  summary          String
  priority         Priority
  confidence       Float
  explanation      String
  evidence         Json
  actions          Json
  requiresApproval Boolean                @default(true)
  status           RecommendationStatus   @default(PENDING)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  @@index([cropId, status])
}

model WeeklyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  cropId      String   @db.Uuid
  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  weekEnd     DateTime
  summary     String
  tasks       Json
  generatedAt DateTime @default(now())
  @@index([cropId, weekStart])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId    String?   @db.Uuid
  crop      Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  structuredData Json?
  createdAt      DateTime     @default(now())
  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}
